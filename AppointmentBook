public class AppointmentBook {
    private boolean[][] periods;

    public AppointmentBook() {
        periods = new boolean[8][60];
        // Initialize all minutes as free
        for (int p = 0; p < 8; p++) {
            for (int m = 0; m < 60; m++) {
                periods[p][m] = true;
            }
        }
    }

    public void initializePeriod(int period, boolean[] availability) {
        for (int m = 0; m < 60; m++) {
            periods[period - 1][m] = availability[m];
        }
    }

    private boolean isMinuteFree(int period, int minute) {
        return periods[period - 1][minute];
    }

    private void reserveBlock(int period, int startMinute, int duration) {
        for (int m = startMinute; m < startMinute + duration; m++) {
            periods[period - 1][m] = false;
        }
    }

    public int findFreeBlock(int period, int duration) {
        for (int start = 0; start <= 60 - duration; start++) {
            boolean blockFree = true;
            for (int i = start; i < start + duration; i++) {
                if (!isMinuteFree(period, i)) {
                    blockFree = false;
                    break;
                }
            }
            if (blockFree) {
                return start;
            }
        }
        return -1;
    }

    public boolean makeAppointment(int startPeriod, int endPeriod, int duration) {
        for (int p = startPeriod; p <= endPeriod; p++) {
            int startMinute = findFreeBlock(p, duration);
            if (startMinute != -1) {
                reserveBlock(p, startMinute, duration);
                return true;
            }
        }
        return false;
    }

    public void displayPeriod(int period) {
        System.out.print("Period " + period + " Availability: ");
        for (int m = 0; m < 60; m++) {
            System.out.print(periods[period - 1][m] ? "1" : "0");
        }
        System.out.println();
    }
}
